<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:scrollbars="vertical">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:context=".ViewOffers">

        <TextView
            android:id="@+id/textView19"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/white"
            android:gravity="center"
            android:text="LUXEVISTA OFFERS"
            android:textColor="@color/black"
            android:textSize="34sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imgOffer"
            android:layout_width="match_parent"
            android:layout_height="191dp"
            android:scaleType="fitXY"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView19"
            tools:srcCompat="@drawable/chrismas" />

        <TextView
            android:id="@+id/textView20"
            android:layout_width="match_parent"
            android:layout_height="121dp"
            android:background="@color/white"
            android:ellipsize="none"
            android:gravity="center"
            android:inputType="textMultiLine"
            android:maxLines="10"
            android:padding="16dp"
            android:singleLine="false"
            android:text="Start planning your end of year getaway. Explore our plans for Christmas and New Year in sunny Sri Lanka. "
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imgOffer" />

        <ImageView
            android:id="@+id/imgbeachTours"
            android:layout_width="match_parent"
            android:layout_height="165dp"
            android:scaleType="fitXY"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView19"
            tools:srcCompat="@drawable/su" />

        <TextView
            android:id="@+id/textView21"
            android:layout_width="match_parent"
            android:layout_height="153dp"
            android:background="@color/white"
            android:ellipsize="none"
            android:gravity="center"
            android:inputType="textMultiLine"
            android:maxLines="7"
            android:padding="16dp"
            android:singleLine="false"
            android:text="Maximise your island experience, explore secret surf spots and indulge in a luxury surf retreat."
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imgbeachTours" />

        <ImageView
            android:id="@+id/imgwaterSports"
            android:layout_width="match_parent"
            android:layout_height="225dp"
            android:scaleType="fitXY"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView19"
            tools:srcCompat="@drawable/staylonger" />

        <TextView
            android:id="@+id/textView22"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="@color/white"
            android:ellipsize="none"
            android:gravity="center"
            android:inputType="textMultiLine"
            android:maxLines="7"
            android:padding="16dp"
            android:singleLine="false"
            android:text="The longer you stay, the more you save. Extend your journey and luxuriate in savings of up to 25%."
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imgbeachTours" />

        <ImageView
            android:id="@+id/imgdiningideas"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="fitXY"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView19"
            tools:srcCompat="@drawable/discover" />

        <TextView
            android:id="@+id/textView23"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:ellipsize="none"
            android:gravity="start"
            android:inputType="textMultiLine"
            android:maxLines="7"
            android:padding="16dp"
            android:singleLine="false"
            android:text="Discover Sri Lanka at Anantara Peace Haven Tangalle Resort with an array of benefits and exclusive for the whole family."
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imgdiningideas" />



    </LinearLayout>
</ScrollView>